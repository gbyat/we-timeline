{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "we-timeline/timeline",
	"title": "WE Timeline",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Display posts or custom items in a WE Timeline layout with navigation.",
	"keywords": [ "we timeline", "timeline", "history", "events", "chronik" ],
	"textdomain": "we-timeline",
	"supports": {
		"align": [ "wide", "full" ],
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"__experimentalDefaultControls": {
				"text": true,
				"background": true,
				"link": true
			}
		}
	},
	"attributes": {
		"contentSource": {
			"type": "string",
			"default": "posts"
		},
		"layout": {
			"type": "string",
			"default": "vertical"
		},
		"position": {
			"type": "string",
			"default": "left"
		},
		"visibleItems": {
			"type": "number",
			"default": 3
		},
		"icon": {
			"type": "string",
			"default": "calendar-alt"
		},
		"iconSize": {
			"type": "string",
			"default": "medium"
		},
		"postType": {
			"type": "string",
			"default": "post"
		},
		"taxonomy": {
			"type": "string",
			"default": ""
		},
		"term": {
			"type": "integer",
			"default": 0
		},
		"dateField": {
			"type": "string",
			"default": "date"
		},
		"sortOrder": {
			"type": "string",
			"default": "asc"
		},
		"excerptWordCount": {
			"type": "number",
			"default": 55
		},
		"showFullContent": {
			"type": "boolean",
			"default": false
		},
		"excludeFromMainLoop": {
			"type": "boolean",
			"default": false
		},
		"excludeFromCategoryLists": {
			"type": "boolean",
			"default": false
		},
		"showItemDates": {
			"type": "boolean",
			"default": true
		},
		"showMenu": {
			"type": "boolean",
			"default": false
		},
		"menuGranularity": {
			"type": "string",
			"default": "auto"
		},
		"menuPosition": {
			"type": "string",
			"default": "sidebar"
		},
		"menuAlign": {
			"type": "string",
			"default": "left"
		},
		"menuStyle": {
			"type": "string",
			"default": "default"
		},
		"menuSeparators": {
			"type": "string",
			"default": "none"
		},
		"menuMobileMode": {
			"type": "string",
			"default": "inherit"
		},
		"menuGranularityMobile": {
			"type": "string",
			"default": "decades"
		},
		"menuMobileLabelFormat": {
			"type": "string",
			"default": "year"
		},
		"menuMobileBreakpoint": {
			"type": "number",
			"default": 768
		},
		"stickyHeaderSelector": {
			"type": "string",
			"default": ""
		},
		"itemBorderRadius": {
			"type": "string",
			"default": ""
		},
		"itemBorderWidth": {
			"type": "string",
			"default": ""
		},
		"itemBorderColor": {
			"type": "string",
			"default": ""
		},
		"itemBorderStyle": {
			"type": "string",
			"default": ""
		},
		"itemPadding": {
			"type": "string",
			"default": ""
		},
		"itemGap": {
			"type": "string",
			"default": ""
		},
		"timelineLineColor": {
			"type": "string",
			"default": ""
		},
		"timelineLineActiveColor": {
			"type": "string",
			"default": ""
		},
		"itemBackgroundColor": {
			"type": "string",
			"default": ""
		},
		"iconColor": {
			"type": "string",
			"default": ""
		},
		"dateColor": {
			"type": "string",
			"default": ""
		},
		"menuTextColor": {
			"type": "string",
			"default": ""
		},
		"menuTextColorHover": {
			"type": "string",
			"default": ""
		},
		"menuBackgroundColor": {
			"type": "string",
			"default": ""
		},
		"menuHoverColor": {
			"type": "string",
			"default": ""
		},
		"menuActiveColor": {
			"type": "string",
			"default": ""
		},
		"menuActiveBackgroundColor": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
